<div class="soundpad-ui-container">
    <h2>{{name}}</h2>
        {{#if sounds.length}}
        <ul class="sa-sound-list">
            {{#each @root.sounds as |sound|}}
            {{> "modules/soundscape-adventure/templates/soundscape/parts/sound-list.hbs" sound=sound}}
            {{/each}}
        </ul>
        {{else}}
        <p>No soundpad sounds available.</p>
        {{/if}}
</div>
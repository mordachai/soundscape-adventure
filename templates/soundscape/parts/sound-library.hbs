<header class="sa-library-header">
    <h4 class="divider" style="width: 100%">Sound Library</h4>
    <button class="sa-btn  mood-action" data-type="mood" data-action="showLibrary" aria-label="Close"><i class="fas fa-close"></i></button>
    <input type="search" placeholder="Search sound..." class="filterInput">
</header>

<ul class="sa-library-list">
    {{#each library as |sound| }}
    <li class="sa-library-item data-drag sa-dataset" data-from-library="true" data-library-id="{{this.id}}"
        data-mood-id="{{@root.selected_mood.id}}"
        data-tooltip="Drag into a Loop/Random/Soundpad section to add it to this mood">
        <span class="sa-sound-name" data-full-name="{{sound.name}}">{{sound.name}}</span>
        <button class="sa-btn-simple sound-control" data-tooltip="Preview" data-action="preview-sound">
            <i class="fas fa-play"></i>
        </button>
    </li>
    {{/each}}
</ul>
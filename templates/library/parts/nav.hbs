<nav class="sa-lib-nav">
    <div class="sa-lib-tabs">
        {{#each tabs as |tab|}}
        <button type="button" class="sa-lib-tab {{#if tab.active}}is-active{{/if}}" data-tab="{{tab.id}}">
            <i class="fas {{tab.icon}}"></i> {{tab.label}}
        </button>
        {{/each}}
    </div>

    <div class="sa-lib-actions">
        <label class="sa-lib-volume" data-tooltip="Preview volume">
            <i class="fas fa-volume-high"></i>
            <input type="range" class="sa-lib-volume__slider" min="0" max="1" step="0.01" value="{{volume}}"
                aria-label="Preview volume">
        </label>
        {{#if missing}}
        <button type="button" class="sa-lib-btn sa-lib-btn--danger" data-action="clean-missing">
            <i class="fas fa-broom"></i> Clean missing ({{missing}})
        </button>
        {{/if}}
        <select class="sa-lib-playlist" data-tooltip="Target playlist for “Add to playlist”">
            <option value="">Playlist: ask each time</option>
            {{#each playlists as |pl|}}
            <option value="{{pl.id}}" {{#if pl.selected}}selected{{/if}}>{{pl.name}}</option>
            {{/each}}
        </select>
        <button type="button" class="sa-lib-btn sa-lib-btn--ghost" data-action="roots" data-tooltip="Manage library roots">
            <i class="fas fa-folder-open"></i> Roots
        </button>
        <button type="button" class="sa-lib-btn" data-action="import">
            <i class="fas fa-folder-plus"></i> Import
        </button>
        <button type="button" class="sa-lib-btn sa-lib-btn--ghost" data-action="refresh">
            <i class="fas fa-rotate"></i> Refresh
        </button>
        <button type="button" class="sa-lib-btn sa-lib-btn--ghost" data-action="duplicates"
            data-tooltip="Find duplicate audio by content">
            <i class="fas fa-clone"></i> Duplicates
        </button>
    </div>
</nav>
